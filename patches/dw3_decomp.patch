diff --git a/include/engine/item_access.h b/include/engine/item_access.h
new file mode 100644
index 0000000..7b7e209
--- /dev/null
+++ b/include/engine/item_access.h
@@ -0,0 +1,43 @@
+#ifndef DW3_ITEM_ACCESS_H
+#define DW3_ITEM_ACCESS_H
+
+/*
+ * The item counts of the game state: how the code reaches GAME.items and GAME.equippedItems.
+ *
+ * PS1 build: the macros expand to exactly the text they replace, so the preprocessed output
+ * (and the matching build) does not change.
+ *
+ * PC port (DW3_PC, ADR-008): the GameState members are renamed (game_state.h), so a direct
+ * index does not compile. The macros call pcItemCountRef / pcItemEquippedRef (pc/shim/ext_state.c):
+ * ids of the original range hit GAME, ids above it hit the port's extension store. Both give an
+ * lvalue, so `PC_ITEM_COUNT(id)++` and `+= n` work as before.
+ */
+
+#ifdef DW3_PC
+
+s8 *pcItemCountRef(int id);
+s8 *pcItemEquippedRef(int id);
+
+#define PC_ITEM_COUNT(id) (*pcItemCountRef(id))
+#define PC_ITEM_EQUIPPED(id) (*pcItemEquippedRef(id))
+
+/* The original item an id stands for in decisions keyed on the item's identity (battle: its script row, idle motion
+   and special case): an original id is itself, a mod item is the original item it is "based on" (following the
+   chain). The item's own data (amount, name, count) is still read through its own id. pc/shim/ext_state.c. */
+int pcItemBase(int id);
+#define PC_ITEM_BASE(id) pcItemBase(id)
+/* a log line (DW3_LOG=mods, [items]) of the script row a battle item resolved to */
+void pcItemScriptLog(int item, int effect, int sound);
+#define PC_ITEM_SCRIPT_LOG(item, effect, sound) pcItemScriptLog(item, effect, sound)
+
+#else
+
+#define PC_ITEM_COUNT(id) GAME.items[id]
+#define PC_ITEM_EQUIPPED(id) GAME.equippedItems[id]
+
+#define PC_ITEM_BASE(id) (id)
+#define PC_ITEM_SCRIPT_LOG(item, effect, sound) ((void)0)
+
+#endif
+
+#endif /* DW3_ITEM_ACCESS_H */
diff --git a/include/engine/partner_access.h b/include/engine/partner_access.h
new file mode 100644
index 0000000..8e3927f
--- /dev/null
+++ b/include/engine/partner_access.h
@@ -0,0 +1,40 @@
+#ifndef DW3_PARTNER_ACCESS_H
+#define DW3_PARTNER_ACCESS_H
+
+/*
+ * A partner's Digimon (PartnerStats.entries): how the code reaches an entry and how many there are.
+ *
+ * PC_PARTNER_ENTRY(partner, i) is entry `i` of `partner` and is an lvalue, as GAME.partners[partner].info.entries[i] was.
+ * PC_PARTNER_ENTRY_LIMIT(partner) is how many entries the partner can hold now (the loops' bound).
+ * PC_ENTRY_LIST(n) is the size of a buffer that listPartnerEntries fills: the PS1 size n, or n plus the room the port adds.
+ *
+ * PS1 build: the macros expand to exactly the text they replace (PARTNER_ENTRY_COUNT is 44), so the preprocessed output
+ * (and the matching build) does not change.
+ *
+ * PC port (DW3_PC, ADR-008 M3): the first PARTNER_ENTRY_COUNT entries stay in the saved GAME block, exactly as in the
+ * original; the entries after them live in the port's per-partner store (pc/shim/ext_state.c), up to
+ * PC_PARTNER_ENTRY_MAX in all, and are saved in their own dw3save chunk ("EXTP").
+ */
+
+#ifdef DW3_PC
+
+#define PC_PARTNER_ENTRY_MAX 256 /* entries one partner can hold in the port: the 44 of the original and the store's */
+
+PartnerEntry *pcPartnerEntryRef(PartnerStats *info, int partner, int index);
+int pcPartnerEntryLimit(int partner);
+int pcPartnerEntryGrow(int partner); /* one more free entry for the partner: its index, or -1 at PC_PARTNER_ENTRY_MAX */
+void pcPartnerEntriesReset(void);    /* forgets the stored entries (a new game, a save load) */
+
+#define PC_PARTNER_ENTRY(partner, i) (*pcPartnerEntryRef(&GAME.partners[partner].info, partner, i))
+#define PC_PARTNER_ENTRY_LIMIT(partner) pcPartnerEntryLimit(partner)
+#define PC_ENTRY_LIST(n) ((n) + PC_PARTNER_ENTRY_MAX - PARTNER_ENTRY_COUNT)
+
+#else
+
+#define PC_PARTNER_ENTRY(partner, i) GAME.partners[partner].info.entries[i]
+#define PC_PARTNER_ENTRY_LIMIT(partner) PARTNER_ENTRY_COUNT
+#define PC_ENTRY_LIST(n) n
+
+#endif
+
+#endif /* DW3_PARTNER_ACCESS_H */
diff --git a/include/engine/tech_access.h b/include/engine/tech_access.h
new file mode 100644
index 0000000..5cddc7d
--- /dev/null
+++ b/include/engine/tech_access.h
@@ -0,0 +1,41 @@
+#ifndef DW3_TECH_ACCESS_H
+#define DW3_TECH_ACCESS_H
+
+/*
+ * The technique table (TECHS): how the code reaches an entry.
+ *
+ * PC_TECH(index) is the entry at `index` (0-based: technique n is PC_TECH(n - 1)) and is an lvalue,
+ * so `&PC_TECH(i)` and `PC_TECH(i).mp` work as before.
+ *
+ * PS1 build: the macros expand to exactly the text they replace, so the preprocessed output
+ * (and the matching build) does not change.
+ *
+ * PC port (DW3_PC, ADR-008): the table is renamed (TECHS_CARD, game_state.h), so a direct TECHS[]
+ * does not compile. The macros call pcTechRef (pc/shim/ext_state.c): indexes of the original table
+ * hit it; anything else gets a scratch entry (the store for ids above it comes with the content registry).
+ */
+
+#ifdef DW3_PC
+
+TechData *pcTechRef(int index);
+
+#define PC_TECH(index) (*pcTechRef(index))
+/* the address `TECHS + offset` (the same entry as &PC_TECH(offset)) */
+#define PC_TECH_PLUS(offset) (&PC_TECH(offset))
+
+/* Whether the field menu's Techniques screen lists technique `id` (a healing technique usable outside battle):
+   the original ids 0xB8..0xBC, and a technique a content mod declares "based on" one of them
+   (pc/shim/ext_state.c, pcTechIsFieldHeal). The data has no flag for it, so the original id range is the marker. */
+int pcTechIsFieldHeal(int id);
+#define PC_TECH_IS_FIELD_HEAL(id) pcTechIsFieldHeal(id)
+
+#else
+
+#define PC_TECH(index) TECHS[index]
+#define PC_TECH_PLUS(offset) TECHS + offset
+
+#define PC_TECH_IS_FIELD_HEAL(id) ((id) >= 0xB8 && (id) < 0xBD)
+
+#endif
+
+#endif /* DW3_TECH_ACCESS_H */
