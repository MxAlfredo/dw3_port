diff --git a/include/cardgame/card_access.h b/include/cardgame/card_access.h
new file mode 100644
index 0000000..f63d097
--- /dev/null
+++ b/include/cardgame/card_access.h
@@ -0,0 +1,39 @@
+#ifndef DW3_CARD_ACCESS_H
+#define DW3_CARD_ACCESS_H
+
+/*
+ * The card counts of the game state and the album's size: how the code reaches GAME.cards, GAME.cardsSeen and the number of
+ * cards. Same idea as engine/item_access.h.
+ *
+ * PS1 build: the macros expand to exactly the text they replace (the matching build does not change).
+ *
+ * PC port (DW3_PC, ADR-009): ids below PC_CARD_ORIG_COUNT hit GAME, ids from there up hit the port's extension store (the cards
+ * content mods add, pc/shim/ext_state.c); anything else is a scratch slot that reads 0. Both give an lvalue.
+ * PC_CARD_TOTAL is the number of ids the album and the deck editor walk (315 without mods, the new cards after the 317 first
+ * ids with them); PC_CARD_LIST_MAX the size of a table indexed by card id.
+ */
+
+#ifdef DW3_PC
+
+#define PC_CARD_ORIG_COUNT 317 /* GameState.cards[0x13D] */
+#define PC_CARD_LIST_MAX 1024  /* the largest id + 1 a mod can give a card */
+
+s8 *pcCardCountRef(int id);
+u8 *pcCardSeenRef(int id);
+int pcCardTotal(void);
+s16 pcCardPrice(s32 id); /* what the card shop charges for a card a mod added (its cards.json "price"; 1 when it gives none) */
+
+#define PC_CARD_COUNT(id) (*pcCardCountRef(id))
+#define PC_CARD_SEEN(id) (*pcCardSeenRef(id))
+#define PC_CARD_TOTAL pcCardTotal()
+
+#else
+
+#define PC_CARD_COUNT(id) GAME.cards[id]
+#define PC_CARD_SEEN(id) GAME.cardsSeen[id]
+#define PC_CARD_TOTAL 315
+#define PC_CARD_LIST_MAX 315
+
+#endif
+
+#endif /* DW3_CARD_ACCESS_H */
