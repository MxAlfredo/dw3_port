diff --git a/include/engine/digimon_access.h b/include/engine/digimon_access.h
new file mode 100644
index 0000000..9cf1bdc
--- /dev/null
+++ b/include/engine/digimon_access.h
@@ -0,0 +1,59 @@
+#ifndef DW3_DIGIMON_ACCESS_H
+#define DW3_DIGIMON_ACCESS_H
+
+/*
+ * The Digimon table (DIGIMON_DATA): how the code reaches a row.
+ *
+ * PC_DIGIMON(row) is the row `row` (0-based: the first partner form is PC_DIGIMON(0)) and is an lvalue,
+ * so `&PC_DIGIMON(i)` and `PC_DIGIMON(i).hp` work as before. A row is NOT a Digimon id: the id is
+ * PC_DIGIMON(row).id and findDigimon maps an id to its row.
+ *
+ * PC_DIGIMON_BASE is the first row as a pointer, for loops that walk the original rows.
+ *
+ * PS1 build: the macros expand to exactly the text they replace, so the preprocessed output
+ * (and the matching build) does not change.
+ *
+ * PC port (DW3_PC, ADR-008): the table is renamed (DIGIMON_DATA_CARD, game_state.h), so a direct
+ * DIGIMON_DATA does not compile. The macros call pcDigimonRef (pc/shim/ext_state.c): rows 0..54 hit the
+ * original table, rows 55 and up are the port's growable store (pcDigimonExtendRows), anything else gets
+ * a scratch row. PC_DIGIMON_BASE is only valid for the original rows (they are contiguous).
+ *
+ * PC_DIGIMON_NAME(d) is the name string (DIGNAM entry) of the DigimonData `d` points to. PS1 build: d->nameId, the same text as
+ * before. PC port: pcDigimonNameId, which gives a new partner form the entry its u8 nameId cannot hold.
+ *
+ * Fields that store a row + 1 in a u8 (DigimonData.pairPartner, blastForms) cap the row at 254; Evolution.digimon is an s32. PC_DIGIMON_BLAST / PC_DIGIMON_PAIR read them in 16 bits on the PC port (ext_state.h, U9).
+ */
+
+#ifdef DW3_PC
+
+#define PC_DIGIMON_ORIG_COUNT 55 /* rows of the original table: 52 real forms and 3 placeholders */
+
+DigimonData *pcDigimonRef(int row);
+int pcDigimonRowCount(void); /* original rows + the rows pcDigimonExtendRows added */
+
+#define PC_DIGIMON(row) (*pcDigimonRef(row))
+#define PC_DIGIMON_BASE (&PC_DIGIMON(0))
+
+int pcDigimonNameId(const DigimonData *d);
+#define PC_DIGIMON_NAME(d) pcDigimonNameId(d)
+
+/* the 16-bit row + 1 of a blast form (tier 0..4) and of a pair partner (U9; ext_state.h), and what a pair partner is compared with */
+int pcDigimonBlast(const DigimonData *d, int tier);
+int pcDigimonPair(const DigimonData *d);
+int pcDigimonRefOf(const DigimonData *d);
+#define PC_DIGIMON_BLAST(d, tier) pcDigimonBlast(d, tier)
+#define PC_DIGIMON_PAIR(d) pcDigimonPair(d)
+#define PC_DIGIMON_REF(d) pcDigimonRefOf(d)
+
+#else
+
+#define PC_DIGIMON(row) DIGIMON_DATA[row]
+#define PC_DIGIMON_BASE DIGIMON_DATA
+#define PC_DIGIMON_NAME(d) d->nameId
+#define PC_DIGIMON_BLAST(d, tier) (d)->blastForms[tier]
+#define PC_DIGIMON_PAIR(d) (d)->pairPartner
+#define PC_DIGIMON_REF(d) (d)->nameId
+
+#endif
+
+#endif /* DW3_DIGIMON_ACCESS_H */
