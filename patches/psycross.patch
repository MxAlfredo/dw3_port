+// The screen rectangle inside a winW x winH window. `mode` 0: all of it (stretched);
+// 1 (integer): the biggest whole multiple of baseW x baseH that fits, centred, and a
+// window smaller than one base image falls back to all of it; 2 (keep aspect): the
+// biggest rectangle with the base image's shape, centred, black bars on the long side.
+extern "C" void PsyX_CalcScreenRect(int winW, int winH, int baseW, int baseH, int mode, int* x, int* y, int* w, int* h)
+{
+	int n = 0;
+
+	if (mode == 2 && baseW > 0 && baseH > 0 && winW > 0 && winH > 0)
+	{
+		// compare winW/winH with baseW/baseH without floats
+		if ((long long)winW * baseH <= (long long)winH * baseW)
+		{
+			*w = winW;
+			*h = (int)((long long)winW * baseH / baseW);
+		}
+		else
+		{
+			*h = winH;
+			*w = (int)((long long)winH * baseW / baseH);
+		}
+		*x = (winW - *w) / 2;
+		*y = (winH - *h) / 2;
+		return;
+	}
+
+	if (mode == 1 && baseW > 0 && baseH > 0)
+	{
+		n = winW / baseW;
+		if (winH / baseH < n)
+			n = winH / baseH;
+	}
+
+	if (n < 1)
+	{
+		*x = 0;
+		*y = 0;
+		*w = winW;
+		*h = winH;
+		return;
+	}
+
+	*w = n * baseW;
+	*h = n * baseH;
+	*x = (winW - *w) / 2;
+	*y = (winH - *h) / 2;
+}
