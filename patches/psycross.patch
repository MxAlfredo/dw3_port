+// ---- the host overlay (include/PsyX/PsyX_overlay.h) ----
+// Signed-distance shapes inside a rectangle, drawn as a four-vertex strip with the finished frame's alpha blending.
+// The shader gets everything in uniforms: no textures, no buffers.
+static const char* overlay_shader = R"(
+	uniform vec4 u_rect;
+	uniform vec2 u_res;
+	uniform vec4 u_color;
+	uniform vec2 u_shape;
+	uniform float u_rows[7];
+	varying vec2 v_p;
+#ifdef VERTEX
+	void main() {
+		vec2 c = vec2(mod(float(gl_VertexID), 2.0), floor(float(gl_VertexID) / 2.0));
+		v_p = c * 2.0 - 1.0;
+		gl_Position = vec4((u_rect.xy + c * u_rect.zw) / u_res * 2.0 - 1.0, 0.0, 1.0);
+	}
+#endif
+#ifdef FRAGMENT
+	float seg(vec2 p, vec2 a, vec2 b) {
+		vec2 pa = p - a, ba = b - a;
+		float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
+		return length(pa - ba * h);
+	}
+	float tri(vec2 p, vec2 a, vec2 b, vec2 c) {
+		vec2 e0 = b - a, e1 = c - b, e2 = a - c;
+		vec2 v0 = p - a, v1 = p - b, v2 = p - c;
+		vec2 p0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
+		vec2 p1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
+		vec2 p2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);
+		float s = sign(e0.x * e2.y - e0.y * e2.x);
+		vec2 d = min(min(vec2(dot(p0, p0), s * (v0.x * e0.y - v0.y * e0.x)),
+		                 vec2(dot(p1, p1), s * (v1.x * e1.y - v1.y * e1.x))),
+		             vec2(dot(p2, p2), s * (v2.x * e2.y - v2.y * e2.x)));
+		return -sqrt(d.x) * sign(d.y);
+	}
+	void main() {
+		vec2 half_ = 0.5 * u_rect.zw;
+		vec2 p = v_p * half_;
+		float k = u_shape.x;
+		float w = u_shape.y;
+		float R = min(half_.x, half_.y);
+		float d = 1.0;
+		if (k < 0.5) {
+			d = length(p) - R;
+		} else if (k < 1.5) {
+			d = abs(length(p) - (R - 0.5 * w)) - 0.5 * w;
+		} else if (k < 2.5) {
+			vec2 q = abs(p) - half_ + R;
+			d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - R;
+		} else if (k < 3.5) {
+			float a = R * 0.5;
+			d = min(seg(p, vec2(-a, -a), vec2(a, a)), seg(p, vec2(-a, a), vec2(a, -a))) - 0.5 * w;
+		} else if (k < 4.5) {
+			float r = R * 0.55;
+			vec2 a = vec2(0.0, r), b = vec2(-0.866 * r, -0.5 * r), c = vec2(0.866 * r, -0.5 * r);
+			d = min(min(seg(p, a, b), seg(p, b, c)), seg(p, c, a)) - 0.5 * w;
+		} else if (k < 5.5) {
+			float s = R * 0.48;
+			d = abs(max(abs(p.x), abs(p.y)) - s) - 0.5 * w;
+		} else if (k < 6.5) {
+			d = abs(length(p) - R * 0.5) - 0.5 * w;
+		} else if (k < 7.5) {
+			float r = R * 0.55;
+			d = tri(p, vec2(r, 0.0), vec2(-0.5 * r, 0.866 * r), vec2(-0.5 * r, -0.866 * r));
+		} else if (k < 8.5) {
+			vec2 q1 = abs(p - vec2(0.0, half_.y * 0.38)) - vec2(half_.x * 0.55, half_.y * 0.1);
+			vec2 q2 = abs(p + vec2(0.0, half_.y * 0.38)) - vec2(half_.x * 0.55, half_.y * 0.1);
+			d = min(length(max(q1, 0.0)) + min(max(q1.x, q1.y), 0.0), length(max(q2, 0.0)) + min(max(q2.x, q2.y), 0.0));
+		} else {
+			vec2 g = vec2(v_p.x * 0.5 + 0.5, 0.5 - v_p.y * 0.5) * vec2(5.0, 7.0);
+			float col = floor(g.x), row = floor(g.y);
+			d = 1.0;
+			if (col >= 0.0 && col < 5.0 && row >= 0.0 && row < 7.0) {
+				float bits = u_rows[int(row)];
+				float on = mod(floor(bits / exp2(4.0 - col)), 2.0);
+				d = on > 0.5 ? -1.0 : 1.0;
+			}
+		}
+		float a = clamp(0.5 - d, 0.0, 1.0);
+		if (a <= 0.0)
+			discard;
+		fragColor = vec4(u_color.rgb, u_color.a * a);
+	}
+#endif
+)";
+
+static PsyXOverlayHook g_overlayHook = NULL;
+static int g_overlayActive = 0;
+static ShaderID g_overlayProg = 0;
+static GLint g_overlayLoc[5];
