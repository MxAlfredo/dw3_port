+/* T32: per-texel PS1 transparency. The real GPU lets the CLUT entry's bit 15
+   (STP) decide, per texel, whether a semi-transparent primitive blends or
+   draws opaque. PsyX already decodes bit 15 into the fragment alpha (0.5 STP,
+   1.0 non-STP) but blending for ADD/SUBTRACT ignores alpha, so every texel
+   blends. The caller splits the draw in two passes: pass 1 (blend off) draws
+   the non-STP texels opaque, pass 2 draws the STP texels with the equation
+   on. Pass 0 restores the plain single-pass behaviour. */
+void GR_SetStpPass(int pass)
+{
+#if USE_OPENGL
+	if (u_stpPassLoc != -1)
+		glUniform1f(u_stpPassLoc, (float)pass);
