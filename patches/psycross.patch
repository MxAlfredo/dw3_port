+static bool PolyTriangleTooLarge(const VERTTYPE* p0, const VERTTYPE* p1, const VERTTYPE* p2)
+{
+	const int minX = std::min((int)p0[0], std::min((int)p1[0], (int)p2[0]));
+	const int maxX = std::max((int)p0[0], std::max((int)p1[0], (int)p2[0]));
