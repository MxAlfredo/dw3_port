+// Scanlines: every other line of the game image (as scaled on screen) darkened, drawn
+// once over the finished frame, after it was copied to VRAM so the game never sees it.
+// One fullscreen triangle; the fragment shader picks the lines from gl_FragCoord.
+static const char* scanlines_shader = R"(
+	uniform vec4 u_rect;
+	uniform vec2 u_params;
+#ifdef VERTEX
+	void main() {
+		gl_Position = vec4((gl_VertexID == 1) ? 3.0 : -1.0, (gl_VertexID == 2) ? 3.0 : -1.0, 0.0, 1.0);
+	}
+#endif
+#ifdef FRAGMENT
+	void main() {
+		vec2 d = gl_FragCoord.xy - u_rect.xy;
+		if (d.x < 0.0 || d.y < 0.0 || d.x >= u_rect.z || d.y >= u_rect.w)
+			discard;
+		float line = floor((u_rect.w - d.y) * u_params.x / u_rect.w);
+		if (mod(line, 2.0) < 0.5)
+			discard;
+		fragColor = vec4(0.0, 0.0, 0.0, u_params.y);
+	}
+#endif
+)";
+
+void GR_DrawScanlines()
+{
+#if USE_OPENGL
+	static ShaderID prog = 0;
+	static GLuint vao = 0;
+	static GLint rectLoc = -1, paramsLoc = -1;
+
+	if (!g_cfg_scanlines || g_scanlinesDrawn)
+		return;
+	g_scanlinesDrawn = 1;
+
+	if (!prog)
+	{
+		prog = GR_Shader_Compile(scanlines_shader, false);
+		rectLoc = glGetUniformLocation(prog, "u_rect");
+		paramsLoc = glGetUniformLocation(prog, "u_params");
+		glGenVertexArrays(1, &vao);
+	}
+
+	// save what is touched, so the cached state of the other draws stays true
+	GLint oldProg, oldVao, oldSrcRgb, oldDstRgb, oldSrcA, oldDstA, oldEqRgb, oldEqA;
+	glGetIntegerv(GL_CURRENT_PROGRAM, &oldProg);
+	glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &oldVao);
+	glGetIntegerv(GL_BLEND_SRC_RGB, &oldSrcRgb);
+	glGetIntegerv(GL_BLEND_DST_RGB, &oldDstRgb);
+	glGetIntegerv(GL_BLEND_SRC_ALPHA, &oldSrcA);
+	glGetIntegerv(GL_BLEND_DST_ALPHA, &oldDstA);
+	glGetIntegerv(GL_BLEND_EQUATION_RGB, &oldEqRgb);
+	glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &oldEqA);
+	const GLboolean oldBlend = glIsEnabled(GL_BLEND);
+	const GLboolean oldDepth = glIsEnabled(GL_DEPTH_TEST);
+	const GLboolean oldScissor = glIsEnabled(GL_SCISSOR_TEST);
+	const GLboolean oldStencil = glIsEnabled(GL_STENCIL_TEST);
+
+	int x, y, w, h;
+	GR_GetViewRect(&x, &y, &w, &h);
+
+	glViewport(0, 0, g_windowWidth, g_windowHeight);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_SCISSOR_TEST);
+	glDisable(GL_STENCIL_TEST);
+	glEnable(GL_BLEND);
+	glBlendEquation(GL_FUNC_ADD);
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+	glUseProgram(prog);
+	glUniform4f(rectLoc, (float)x, (float)y, (float)w, (float)h);
+	glUniform2f(paramsLoc, activeDispEnv.disp.h > 0 ? (float)activeDispEnv.disp.h : 240.0f, 0.4f);
+	glBindVertexArray(vao);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	glBindVertexArray(oldVao);
+	glUseProgram(oldProg);
+	glBlendEquationSeparate(oldEqRgb, oldEqA);
+	glBlendFuncSeparate(oldSrcRgb, oldDstRgb, oldSrcA, oldDstA);
+	if (!oldBlend) glDisable(GL_BLEND);
+	if (oldDepth) glEnable(GL_DEPTH_TEST);
+	if (oldScissor) glEnable(GL_SCISSOR_TEST);
+	if (oldStencil) glEnable(GL_STENCIL_TEST);
+#endif
+}
