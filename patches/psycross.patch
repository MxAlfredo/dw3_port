+	if (pass == 1)
+	{
+		if (g_stpBlendDisabled == 0)
+		{
+			glDisable(GL_BLEND);
+			g_stpBlendDisabled = 1;
+		}
+	}
+	else if (g_stpBlendDisabled != 0)
+	{
+		glEnable(GL_BLEND);
+		g_stpBlendDisabled = 0;
+	}
+#endif
+}
