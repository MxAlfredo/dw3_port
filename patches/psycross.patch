new file mode 100644
index 0000000..17f82ca
--- /dev/null
+++ b/include/PsyX/PsyX_overlay.h
@@ -0,0 +1,54 @@
+#ifndef PSYX_OVERLAY_H
+#define PSYX_OVERLAY_H
+
+/*
+ * A small 2D overlay drawn over the finished frame, in window pixels, after the game image (and the scanlines) and
+ * right before the window is shown. It is for things that belong to the host and not to the game: an on-screen
+ * controller, a debug counter. The game never sees it (it is drawn after the frame was copied to VRAM).
+ *
+ * The host registers one hook; PsyX_EndScene runs it with the window's GL state set up (full-window viewport,
+ * alpha blending, no depth/scissor/stencil) and the hook calls PsyX_OverlayShape for every shape. The shapes are
+ * signed-distance shapes inside a rectangle, antialiased, so the host needs no textures and no GL calls of its own.
+ */
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+enum {
+    PSYX_SHAPE_DISC = 0,    /* filled circle inscribed in the rect */
+    PSYX_SHAPE_RING,        /* circle outline, line width = param (pixels) */
+    PSYX_SHAPE_PILL,        /* filled rounded rectangle, fully rounded ends */
+    PSYX_SHAPE_CROSS,       /* an X (the PlayStation cross), line width = param */
+    PSYX_SHAPE_TRIANGLE,    /* an upward triangle outline, line width = param */
+    PSYX_SHAPE_SQUARE,      /* a square outline, line width = param */
+    PSYX_SHAPE_CIRCLE,      /* a small circle outline (the PlayStation circle), line width = param */
+    PSYX_SHAPE_PLAY,        /* a filled triangle pointing right */
+    PSYX_SHAPE_BARS,        /* two horizontal bars */
+    PSYX_SHAPE_GLYPH        /* a 5x7 bitmap: rows[0..6], bit 4 = leftmost column */
+};
+
+typedef struct PsyXOverlayShape {
+    int kind;
+    float x, y, w, h;       /* window pixels, origin top left */
+    float r, g, b, a;       /* 0..1, straight (not premultiplied) alpha */
+    float param;            /* line width for the outline shapes */
+    unsigned char rows[7];  /* PSYX_SHAPE_GLYPH only */
+} PsyXOverlayShape;
+
+typedef void (*PsyXOverlayHook)(void);
+
+/* Registers the hook (NULL removes it). One hook; the host owns it. */
+void PsyX_SetOverlayHook(PsyXOverlayHook hook);
+/* Runs the hook now with the GL state set up. PsyX_EndScene calls it; a host that saves the frame itself before
+   the swap may call it first so the shot shows the overlay. A no-op without a hook. */
+void PsyX_OverlayRun(void);
+/* Draws one shape. Only valid while the hook runs. */
+void PsyX_OverlayShape(const PsyXOverlayShape *shape);
+/* Where the game image is in the window right now (window pixels, origin top left), as the scaling mode lays it out. */
+void PsyX_GetViewRect(int *x, int *y, int *w, int *h);
+
+#if defined(__cplusplus)
+}
+#endif
+
+#endif
