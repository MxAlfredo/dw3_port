            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "expLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "family": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "A value some original partner uses."
          },
          "stats": {
            "type": "object",
            "description": "A partner form takes strength, defense, spirit, wisdom, speed, charisma (0..999); an enemy takes attack, defense, spirit, wisdom, speed (0..32767).",
            "properties": {
              "strength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "attack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "defense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "spirit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "wisdom": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "speed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "charisma": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              }
            },
            "additionalProperties": false
          },
          "resistances": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            },
            "description": "Seven values; a partner form 0..999, an enemy 0..32767."
          },
          "statusResists": {
            "type": "object",
            "properties": {
              "poison": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "paralysis": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "confusion": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
