{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DW3 port digimon/<name>/digimon.json (digimon-digimon-v1)",
  "description": "One Digimon of a content mod. A folder d<nnn> (the fighter id on three digits) changes original <nnn>: only partner or enemy (the facet that matches the id) are read. Any other folder name is a new Digimon: base and title are required, with the partner or enemy fields of its base, the model and the evolution. Derived from pc/shim/digimon_ext.c (kPartnerFields, kEnemyFields, takeKey) and content.c.",
  "type": "object",
  "required": [
    "format"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "digimon-digimon-v1"
    },
    "name": {
      "type": "string",
      "description": "Optional header: the folder's name (digimon/<name>/digimon.json). d<nnn> for a change of original <nnn>."
    },
    "notes": {
      "description": "Ignored."
    },
    "base": {
      "type": "string",
      "pattern": "^(dw3:digimon/[0-9]+|[A-Za-z0-9._-]+:[a-z0-9_-]+)$"
    },
    "model": {
      "type": "string",
      "pattern": "^(dw3:digimon/[0-9]+|[A-Za-z0-9._-]+:[a-z0-9_-]+)$"
    },
    "title": {
      "type": "object",
      "description": "The name per language folder: eng, fra, ita, ger, spa, es-419 (es-419 falls back to spa, then eng). eng is required in a new Digimon (a folder that is not d<nnn>).",
      "properties": {
        "eng": {
          "type": "string"
        },
        "fra": {
          "type": "string"
        },
        "ita": {
          "type": "string"
        },
        "ger": {
          "type": "string"
        },
        "spa": {
          "type": "string"
        },
        "es-419": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "description": "Text per language folder: eng, fra, ita, ger, spa, es-419 (es-419 falls back to spa, then eng). eng is required for a name.",
      "properties": {
        "eng": {
          "type": "string"
        },
        "fra": {
          "type": "string"
        },
        "ita": {
          "type": "string"
        },
        "ger": {
          "type": "string"
        },
        "spa": {
          "type": "string"
        },
        "es-419": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "blastForms": {
      "description": "A new partner form: the five forms a blast turns it into by level tier (1-3, 4-18, 19-38, 39-69, 70 and up), each a partner form by name; the base's stay without it.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "pairPartner": {
      "description": "A new partner form: the partner form it does its pair technique with, by name, or 0 for none; the base's stays without it.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "const": 0
        }
      ]
    },
    "evolution": {
      "type": "object",
      "properties": {
        "partner": {
          "type": "integer",
          "minimum": 0
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "digimon": {
                "type": "string",
                "pattern": "^(dw3:digimon/[0-9]+|[A-Za-z0-9._-]+:[a-z0-9_-]+)$"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              }
            },
            "required": [
              "digimon"
            ]
          }
        },
        "stat": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
