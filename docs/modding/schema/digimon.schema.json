              "sleep": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "knockOut": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              }
            },
            "additionalProperties": false
          },
          "skills": {
            "type": "object",
            "description": "Skill slot (1..6) -> technique and level.",
            "propertyNames": {
              "pattern": "^[1-6]$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tech": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                }
              },
              "required": [
                "tech"
              ]
            }
          },
          "itemChance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1023
          },
          "techs": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "item": {
            "type": [
              "string",
              "integer"
            ],
            "description": "dw3:item/<id>, a number or <mod>:<key>."
          }
        },
        "additionalProperties": false
