{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DW3 port content/digimon.json (digimon-v1)",
  "description": "New Digimon, changes to existing ones and where new enemies appear. Derived from pc/shim/digimon_ext.c (kPartnerFields, kEnemyFields, takeKey) and content.c.",
  "type": "object",
  "required": [
    "format"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "digimon-v1"
    },
    "new": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_-]{1,48}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "base",
          "name"
        ],
        "description": "A new Digimon: the partner and enemy fields of its base, plus the model and the evolution.",
        "properties": {
          "base": {
            "type": "string",
            "pattern": "^(dw3:digimon/[0-9]+|[A-Za-z0-9._-]+:[a-z0-9_-]+)$"
          },
          "model": {
            "type": "string",
            "pattern": "^(dw3:digimon/[0-9]+|[A-Za-z0-9._-]+:[a-z0-9_-]+)$"
          },
          "name": {
            "type": "object",
            "description": "Text per language folder: eng, fra, ita, ger, spa, es-419 (es-419 falls back to spa, then eng). eng is required for a name.",
            "properties": {
              "eng": {
                "type": "string"
              },
              "fra": {
                "type": "string"
              },
              "ita": {
                "type": "string"
              },
              "ger": {
                "type": "string"
              },
              "spa": {
                "type": "string"
              },
              "es-419": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "description": "Text per language folder: eng, fra, ita, ger, spa, es-419 (es-419 falls back to spa, then eng). eng is required for a name.",
            "properties": {
              "eng": {
                "type": "string"
              },
              "fra": {
                "type": "string"
              },
              "ita": {
                "type": "string"
              },
              "ger": {
                "type": "string"
              },
              "spa": {
                "type": "string"
              },
              "es-419": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "blastForms": {
            "description": "A new partner form: the five forms a blast turns it into by level tier (1-3, 4-18, 19-38, 39-69, 70 and up), each a partner form by name; the base's stay without it.",
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "pairPartner": {
            "description": "A new partner form: the partner form it does its pair technique with, by name, or 0 for none; the base's stays without it.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "const": 0
              }
            ]
          },
          "evolution": {
            "type": "object",
            "properties": {
              "partner": {
                "type": "integer",
                "minimum": 0
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "digimon": {
                      "type": "string",
                      "pattern": "^(dw3:digimon/[0-9]+|[A-Za-z0-9._-]+:[a-z0-9_-]+)$"
                    },
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 99
                    }
                  },
                  "required": [
                    "digimon"
                  ]
                }
              },
              "stat": {
                "type": "string"
              },
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "hp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "mp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "hpGrowth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "mpGrowth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
