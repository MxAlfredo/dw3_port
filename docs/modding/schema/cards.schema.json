{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DW3 port content/cards.json (cards-v1)",
  "description": "New cards. Derived from pc/shim/card_ext.c (kCard, takeField, takeEffect) and content.c.",
  "type": "object",
  "required": [
    "format",
    "new"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "cards-v1"
    },
    "new": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_-]{1,48}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "base",
          "name"
        ],
        "properties": {
          "base": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^(dw3:card/[0-9]+|[A-Za-z0-9._-]+:[a-z0-9_-]+)$",
            "minimum": 1,
            "maximum": 314,
            "description": "The original card the entry starts from: dw3:card/<id> (1..314) or the number. Its stats, art and (cards 1..60) effect are copied."
          },
          "name": {
            "type": "object",
            "description": "Text per language folder: eng, fra, ita, ger, spa, es-419 (es-419 falls back to spa, then eng). eng is required for a name.",
            "properties": {
              "eng": {
                "type": "string"
              },
              "fra": {
                "type": "string"
              },
              "ita": {
                "type": "string"
              },
              "ger": {
                "type": "string"
              },
              "spa": {
                "type": "string"
              },
              "es-419": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "description": "Text per language folder: eng, fra, ita, ger, spa, es-419 (es-419 falls back to spa, then eng). eng is required for a name.",
            "properties": {
              "eng": {
                "type": "string"
              },
              "fra": {
                "type": "string"
              },
              "ita": {
                "type": "string"
              },
              "ger": {
                "type": "string"
              },
              "spa": {
                "type": "string"
              },
              "es-419": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "color": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "ap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "hp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "kind": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16,
            "description": "An index of CARD_KINDS: 1..14 option cards, 16 a Digimon card."
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99,
            "description": "What it adds to its colour."
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32767,
            "default": 1,
            "description": "What the card shop charges for one copy (0 is free). The shops only sell the card when a tables/card_shop_stock.json lists it; without a price it costs 1."
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "description": "By strength, from 1 the strongest."
          },
          "comboCard": {
            "type": "integer",
            "minimum": 0,
            "maximum": 314,
            "description": "The card three or more of it make; 0 for none."
          },
          "effect": {
            "type": "object",
            "description": "The effect of an option card: like (an original option card 1..60) first, then the fields override it.",
            "properties": {
              "like": {
                "type": [
                  "string",
                  "integer"
                ],
                "pattern": "^dw3:card/[0-9]+$",
                "minimum": 1,
                "maximum": 60
              },
              "condition": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "playCondition": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "message": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "target": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "script": {
                "type": "array",
                "maxItems": 39,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 174
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
